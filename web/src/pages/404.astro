---
import { paths } from "../i18n";
import Base from "../layouts/Base.astro";
import { BRAND } from "../lib/site";
---

<Base title={`Page not found · ${BRAND.name}`} description="Page not found" lang="en">
  <section class="container-site py-32 text-center" data-testid="web-not-found">
    <p class="text-sm font-semibold tracking-wide text-brand uppercase">404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-[-0.03em]">This page does not exist.</h1>
    <a
      href={paths.home("en")}
      class="mt-8 inline-block rounded-xl bg-brand px-6 py-3 font-semibold text-brand-foreground"
    >
      Back to the home page
    </a>
  </section>
</Base>
