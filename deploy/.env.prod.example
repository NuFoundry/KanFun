# One file per tier, git-ignored: deploy/.env.prod, deploy/.env.dev, deploy/.env.stage (copy this
# file for each). `pnpm deploy:prod` / `pnpm deploy:dev` (or DEPLOY_ENV=stage) read it: Fly gets
# it as app secrets (with --init or --secrets), a Hetzner server as its .env on every deploy.
APP_NAME="KanFun"
# On Fly.io an empty DOMAIN means https://<name>-web.fly.dev until you have one.
DOMAIN=app.example.com
ACME_EMAIL=you@example.com
# The website (web/) on its own domain; the app stays on DOMAIN. WEB_NOINDEX=true keeps search
# engines out: dev, stage, and prod until launch.
WEB_DOMAIN=example.com
WEB_NOINDEX=false

PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=replace-with-a-long-random-password
# Rate limits (PocketBase per IP, services per user) are on in production; "off" disables them.
RATE_LIMITS=

# One of: a Mistral, OpenAI or Anthropic key (AI_PROVIDER=auto picks the one that is set), or
# AI_PROVIDER=ollama with OLLAMA_URL pointing at your Ollama host.
AI_PROVIDER=auto
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TRANSCRIPTION_MODEL=voxtral-mini-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OLLAMA_URL=
OLLAMA_MODEL=llama3.2






# Email: one provider for everything (app mails and PocketBase's verification / reset mails).
# Lettermint (EU) recommended; Resend stores data in the US; SMTP for any other relay.
# Add the provider's DKIM, SPF (or return-path) and DMARC records for the MAIL_FROM domain first.
# Generate the token: openssl rand -hex 32
MAIL_FROM="KanFun <no-reply@your-domain.com>"
MAIL_INTERNAL_TOKEN=replace-with-openssl-rand-hex-32
LETTERMINT_TOKEN=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
