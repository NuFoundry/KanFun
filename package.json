{
  "name": "kan-fun",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "dev": "bash scripts/dev.sh",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "dev:services": "pnpm --filter \"./services/**\" --parallel dev",
    "build": "pnpm -r --filter \"!e2e\" build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "test": "pnpm -r --workspace-concurrency=1 test && node --test scripts/brand/*.test.ts && pnpm run --if-present test:stripe && pnpm run test:strategy",
    "test:watch": "pnpm --filter client test:watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "check": "bash scripts/check-security.sh all && bash scripts/check-deploy.sh && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "seed": "pnpm --filter server seed",
    "db:reset": "bash scripts/reset-db.sh",
    "typegen": "pnpm --filter server typegen",
    "roadmap": "node scripts/strategy/roadmap.ts",
    "test:strategy": "node --test scripts/strategy/*.test.ts strategy/tools/*.test.ts",
    "brand": "node scripts/brand/build.ts",
    "deploy:prod": "bash deploy/deploy.sh",
    "deploy:dev": "DEPLOY_ENV=dev bash deploy/deploy.sh",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "marked": "^18.1.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
