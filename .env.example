# ---------------------------------------------------------------------------
# Copy to `.env` (root). Every workspace reads this one file.
# Vite only exposes variables prefixed with VITE_ to the browser.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
APP_NAME="KanFun"
NODE_ENV=development
# Rate limits (PocketBase per IP, services per user) are on in production and off elsewhere;
# "off" turns them off in production too (load tests), "on" turns them on locally.
RATE_LIMITS=

# --- PocketBase (server/) --------------------------------------------------
# Where the PocketBase API listens locally.
POCKETBASE_URL=http://127.0.0.1:8090
PB_HOST=127.0.0.1
PB_PORT=8090
# First superuser (admin UI at /_/). Created by the setup wizard / `pnpm bootstrap`.
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=changeme-admin-1234

# Seed users (see server/seed). Same password for all seeded users.
SEED_USER_PASSWORD=password1234

# --- Client (client/) ------------------------------------------------------
# Leave empty to use same-origin relative URLs (Vite proxy in dev, Caddy in prod).
VITE_POCKETBASE_URL=
VITE_AI_URL=
VITE_APP_NAME="KanFun"

# --- Website (web/) ---------------------------------------------------------
# The landing page (Astro). `pnpm dev` points its sign-up links at the local app.
WEB_PORT=4321

# --- AI service (services/ai) ----------------------------------------------
AI_PORT=8787
AI_HOST=127.0.0.1
# auto = the first key below that is set (Mistral, OpenAI, Anthropic); ollama = local models via
# Ollama (no key); echo = no real AI. With no key the service echoes, so everything works offline.
AI_PROVIDER=auto
# Mistral (EU company): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Speech to text for voice messages in browsers that cannot dictate themselves (Firefox):
# Mistral or OpenAI; Anthropic and Ollama borrow whichever of the two has a key, otherwise only
# browsers with speech recognition get a microphone.
MISTRAL_TRANSCRIPTION_MODEL=voxtral-mini-latest
# OpenAI: https://platform.openai.com/api-keys   (gpt-6-luna = efficient, gpt-6-astra = best)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Anthropic: https://console.anthropic.com/settings/keys   (claude-opus-5-5 default,
# claude-sonnet-5-5 cheaper, claude-haiku-4-5 cheapest)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Ollama, self-hosted: https://ollama.com then `ollama pull llama3.2`; set AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Comma separated list of allowed browser origins for the services (dev server + prod domain).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# --- MCP server (services/mcp) -----------------------------------------------
# AI agents (Claude, ChatGPT, Cursor) use the app at <APP_URL>/mcp after the user's consent. It
# uses APP_URL, APP_NAME, POCKETBASE_URL and PB_ADMIN_* from this file; nothing else to set.
MCP_PORT=8791
MCP_HOST=127.0.0.1






# --- Dev server ports --------------------------------------------------------
CLIENT_PORT=5173

# --- E2E ---------------------------------------------------------------------
# Playwright targets this URL. Leave as-is for local runs.
E2E_BASE_URL=http://localhost:5173

# --- Email -------------------------------------------------------------------
# Every email (PocketBase auth mails included) goes through services/mailer, so this block is
# the only email configuration. Without a provider nothing is delivered: in development every
# message lands in the dev inbox at <APP_URL>/dev/mail, in production the mailer logs a warning.
# App URL used in email links (verification, password reset). Prod: https://your-domain.
APP_URL=http://localhost:5173
MAIL_HOST=127.0.0.1
MAIL_PORT=8788
MAIL_URL=http://127.0.0.1:8788
MAIL_FROM="KanFun <no-reply@example.com>"
# Shared secret PocketBase hooks/services use to call POST /mail/send. Change in production.
MAIL_INTERNAL_TOKEN=dev-internal-token-change-me
# auto = Lettermint if LETTERMINT_TOKEN, else Resend if RESEND_API_KEY, else SMTP if SMTP_HOST,
# else the local outbox (no delivery). Whichever you pick: add its DKIM, SPF (or return-path) and
# DMARC records for the MAIL_FROM domain, or mail goes to spam.
MAIL_PROVIDER=auto
# Lettermint (recommended in the EU: Dutch company, servers in the EU; open and click tracking off
# on every message): a project with SMTP on at https://lettermint.co, its API token here.
LETTERMINT_TOKEN=
# Resend (US company, data stored in the US under DPA + SCCs): https://resend.com/api-keys
RESEND_API_KEY=
# Any other SMTP relay on port 465/587 (Postmark, Mailgun, Amazon SES, ...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
